NODE_ENV=development
PORT=3009
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://fraud_svc:<DB_PASSWORD_FRAUD>@localhost:5432/fraud_db
STAFF_JWT_SECRET=
RABBITMQ_URL=amqp://banklite:banklite@localhost:5672
# Umbrales de las reglas de riesgo (opcionales; estos son los valores por defecto).
FRAUD_HIGH_AMOUNT_THRESHOLD=20000000
FRAUD_VELOCITY_MAX_TX=5
FRAUD_VELOCITY_WINDOW_MIN=10
FRAUD_DAILY_OUTFLOW_THRESHOLD=30000000
FRAUD_REVIEW_THRESHOLD=60

# Opcionales (estos son los valores por defecto).
RABBITMQ_EXCHANGE=banklite.events
RABBITMQ_QUEUE=fraud-service.transaction-completed
# Reintentos de un evento que falla antes de mandarlo a la DLQ (<cola>.dlq).
EVENT_MAX_RETRIES=5
EVENT_RETRY_DELAY_MS=10000
