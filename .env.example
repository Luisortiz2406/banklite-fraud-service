NODE_ENV=development
PORT=3009
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://fraud_svc:<DB_PASSWORD_FRAUD>@localhost:5432/fraud_db
STAFF_JWT_SECRET=
RABBITMQ_URL=amqp://banklite:banklite@localhost:5672
# Umbrales de las reglas de riesgo (opcionales; estos son los valores por defecto).
FRAUD_HIGH_AMOUNT_THRESHOLD=20000000
FRAUD_VELOCITY_MAX_TX=5
FRAUD_VELOCITY_WINDOW_MIN=10
FRAUD_DAILY_OUTFLOW_THRESHOLD=30000000
FRAUD_REVIEW_THRESHOLD=60

# Servicios que llaman a /internal/fraud: auth-service (reporta inicios de sesión) y
# account-service (resumen de alertas para cancelar la cuenta). Cada uno solo a lo suyo.
INTERNAL_TRUSTED_KEYS=auth:<clave-de-auth>,account:<clave-de-account>

# Geolocalización por IP (GeoLite2 local de MaxMind). Sin estas variables el servicio
# arranca igual, con "geo": "degradada" en /health y sin reglas de IP.
# Cuenta gratuita en maxmind.com > Manage License Keys. Nunca se suben al repositorio.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Secreto de la huella HMAC de la IP (32+ caracteres aleatorios). Sin él no se guarda
# ningún inicio de sesión. Generarlo con: openssl rand -hex 32
FRAUD_IP_HASH_SECRET=

# Opcionales (estos son los valores por defecto).
# Reglas geográficas: puntos, ventana del viaje imposible, horas en que cuentan para
# las transacciones y retención (purga diaria).
FRAUD_GEO_NEW_COUNTRY_POINTS=20
FRAUD_GEO_IMPOSSIBLE_TRAVEL_POINTS=30
FRAUD_GEO_TOR_POINTS=40
FRAUD_GEO_TRAVEL_WINDOW_MIN=120
FRAUD_GEO_SESSION_HOURS=12
FRAUD_GEO_RETENTION_DAYS=90
RABBITMQ_EXCHANGE=banklite.events
RABBITMQ_QUEUE=fraud-service.transaction-completed
# Reintentos de un evento que falla antes de mandarlo a la DLQ (<cola>.dlq).
EVENT_MAX_RETRIES=5
EVENT_RETRY_DELAY_MS=10000
